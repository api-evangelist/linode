{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Payment",
  "title": "Payment",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "The unique ID of this payment."
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "The date this payment was made."
    },
    "usd": {
      "type": "number",
      "description": "The amount in US dollars."
    }
  }
}