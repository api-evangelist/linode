{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PaginatedKernelList",
  "title": "PaginatedKernelList",
  "allOf": [
    {
      "$ref": "#/components/schemas/Pagination"
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "architecture": {
                "type": "string",
                "enum": [
                  "x86_64",
                  "i386"
                ]
              }
            }
          }
        }
      }
    }
  ]
}