{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SSHKeyRequest",
  "title": "SSHKeyRequest",
  "type": "object",
  "required": [
    "label",
    "ssh_key"
  ],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The label for the SSH key."
    },
    "ssh_key": {
      "type": "string",
      "description": "The SSH public key content."
    }
  }
}