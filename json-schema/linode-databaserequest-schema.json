{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DatabaseRequest",
  "title": "DatabaseRequest",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "description": "The label for the database."
    },
    "allow_list": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IP addresses or CIDRs allowed to connect."
    }
  }
}