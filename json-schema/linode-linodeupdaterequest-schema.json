{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/LinodeUpdateRequest",
  "title": "LinodeUpdateRequest",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "description": "The label for the Linode instance."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for the Linode."
    },
    "watchdog_enabled": {
      "type": "boolean",
      "description": "Whether to enable Lassie the watchdog."
    },
    "alerts": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "integer"
        },
        "io": {
          "type": "integer"
        },
        "network_in": {
          "type": "integer"
        },
        "network_out": {
          "type": "integer"
        },
        "transfer_quota": {
          "type": "integer"
        }
      }
    }
  }
}