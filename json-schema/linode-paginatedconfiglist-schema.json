{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PaginatedConfigList",
  "title": "PaginatedConfigList",
  "allOf": [
    {
      "$ref": "#/components/schemas/Pagination"
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "label": {
                "type": "string"
              },
              "kernel": {
                "type": "string"
              },
              "run_level": {
                "type": "string",
                "enum": [
                  "default",
                  "single",
                  "binbash"
                ]
              },
              "virt_mode": {
                "type": "string",
                "enum": [
                  "paravirt",
                  "fullvirt"
                ]
              },
              "root_device": {
                "type": "string"
              },
              "memory_limit": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  ]
}