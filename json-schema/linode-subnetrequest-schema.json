{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SubnetRequest",
  "title": "SubnetRequest",
  "type": "object",
  "required": [
    "label",
    "ipv4"
  ],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The label for the subnet."
    },
    "ipv4": {
      "type": "string",
      "description": "The IPv4 CIDR range for the subnet."
    }
  }
}