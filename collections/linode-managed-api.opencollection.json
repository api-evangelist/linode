{
  "opencollection": "1.0.0",
  "info": {
    "name": "Linode API v4 Account Managed API",
    "version": "4.189.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Managed",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List managed services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.linode.com/v4/managed/services",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to return."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              }
            ]
          },
          "docs": "Returns a paginated list of Managed services being monitored on your account."
        },
        {
          "info": {
            "name": "Create a managed service",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.linode.com/v4/managed/services",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new Managed service monitor."
        },
        {
          "info": {
            "name": "List managed contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.linode.com/v4/managed/contacts",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to return."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              }
            ]
          },
          "docs": "Returns a paginated list of Managed contacts for your account."
        },
        {
          "info": {
            "name": "List managed issues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.linode.com/v4/managed/issues",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to return."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              }
            ]
          },
          "docs": "Returns a paginated list of recent issues that Managed detected for your services."
        }
      ]
    }
  ],
  "bundled": true
}