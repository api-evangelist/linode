{
  "opencollection": "1.0.0",
  "info": {
    "name": "Linode API v4 Account Support API",
    "version": "4.189.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Support",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List support tickets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.linode.com/v4/support/tickets",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to return."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              }
            ]
          },
          "docs": "Returns a paginated list of support tickets on your account."
        },
        {
          "info": {
            "name": "Open a support ticket",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.linode.com/v4/support/tickets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Opens a new support ticket with the Linode support team."
        }
      ]
    }
  ],
  "bundled": true
}