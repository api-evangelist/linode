{
  "opencollection": "1.0.0",
  "info": {
    "name": "Linode API v4 Account Tags API",
    "version": "4.189.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.linode.com/v4/tags",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to return."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              }
            ]
          },
          "docs": "Returns a paginated list of tags on your account."
        },
        {
          "info": {
            "name": "Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.linode.com/v4/tags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new tag and optionally assigns it to specified resources."
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.linode.com/v4/tags/:label",
            "params": [
              {
                "name": "label",
                "value": "",
                "type": "path",
                "description": "The label of the tag to delete."
              }
            ]
          },
          "docs": "Deletes a tag from your account. The tag will be removed from all resources it was assigned to."
        }
      ]
    }
  ],
  "bundled": true
}